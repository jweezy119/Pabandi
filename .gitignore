# Database dumps. A 45MB database restores in seconds, so these are a local
# convenience rather than the backup of record — but committing a 2MB binary
# that contains every user row and password hash to a git remote is not something
# to do by accident.
backups/
*.dump
*.sql.gz

# Production database URL, deliberately named so Prisma/dotenv does not auto-load it.
# Added 2026-10-10 alongside moving that URL out of server/.env. It holds the
# production password and must never be committed — check-ignore verified.
server/.env.production
.env.production

# Playwright artifacts: traces and reports are regenerated by every run and
# contain screenshots of whatever the test happened to be looking at.
test-results/
playwright-report/
playwright/.cache/
