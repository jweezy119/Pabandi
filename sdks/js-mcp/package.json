{
  "name": "@pabandi/mcp-sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for the Pabandi MCP (Model Context Protocol) server. Enables AI agents to discover tools, call them with x402 micropayments, and manage yield-bearing escrow settlements.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": [
    "pabandi",
    "mcp",
    "model-context-protocol",
    "x402",
    "ai-agent",
    "escrow",
    "settlement",
    "trust",
    "yield"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
