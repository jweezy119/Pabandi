# API Configuration
VITE_API_URL=http://localhost:5000/api/v1

# Privy (embedded wallets / sign-in)
# App ID only — 25 chars, from the Privy dashboard. The app SECRET is
# server-only: it goes in server/.env as PRIVY_APP_SECRET, never here.
VITE_PRIVY_APP_ID=

# Google Maps API (Client UI)
VITE_GOOGLE_MAPS_API_KEY=

# Stripe (USA / Global payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# PayPal
VITE_PAYPAL_CLIENT_ID=

# Square
VITE_SQUARE_APP_ID=
VITE_SQUARE_ACCESS_TOKEN=

# CashApp
VITE_CASHAPP_CLIENT_ID=

# Crypto
VITE_SOLANA_RPC_URL=
VITE_USDC_MINT_ADDRESS=
VITE_PLATFORM_WALLET_ADDRESS=

# Twilio (SMS)
VITE_TWILIO_PHONE_NUMBER=

# Sentry / Monitoring
VITE_SENTRY_DSN=
