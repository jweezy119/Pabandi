// ── Project Simulator ──────────────────────────────────────────────────────
// Restored with the simulator routes. Small and self-contained; they were
// purged in the "core wedge" cleanup along with the routes that used them,
// which left the landing page, the module switcher and the invoice share links
// calling endpoints that no longer existed.
model ProjectSimulation {
  id             String   @id @default(cuid())
  userId         String
  projectType    String
  initialFactors Json
  status         String   @default("draft") // draft | running | completed | failed
  finalEstimate  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agentRuns SimulationAgentRun[]

  @@index([userId])
  @@index([status])
}

model SimulationAgentRun {
  id              String   @id @default(cuid())
  simulationId    String
  agentRole       String // materials | staffing | timeline | cost
  inputPayload    Json
  outputPayload   Json?
  status          String   @default("pending") // pending | running | completed | failed
  executionTimeMs Int?
  createdAt       DateTime @default(now())

  simulation ProjectSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@index([agentRole])
  @@index([status])
}

model OutreachCampaign {
  id             String              @id @default(cuid())
  businessId     String
  name           String
  channel        String              @default("EMAIL")
  subject        String?
  body           String
  // DRAFT -> SENDING -> SENT | FAILED
  status         String              @default("DRAFT")
  // Snapshot of the audience rule, so a campaign stays reproducible after the
  // client list changes underneath it.
  segment        String?
  totalCount     Int                 @default(0)
  sentCount      Int                 @default(0)
  failedCount    Int                 @default(0)
  createdById    String
  // Returned to a retried send so a double-tap cannot email a customer twice.
  idempotencyKey String?             @unique
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  recipients     OutreachRecipient[]

  @@index([businessId, createdAt])
  @@map("outreach_campaigns")
}

model OutreachRecipient {
  id         String    @id @default(cuid())
  campaignId String
  clientId   String?
  // Denormalised so the audit trail survives the client row being deleted.
  to         String
  // PENDING -> SENT | FAILED
  status     String    @default("PENDING")
  error      String?
  sentAt     DateTime?

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("outreach_recipients")
}

model CrmExpense {
