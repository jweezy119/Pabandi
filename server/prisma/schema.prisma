// ── Pabandi Yield Deposit (PYD) ────────────────────────────────────────────────
// Non-custodial rental security deposit infrastructure.
// Pabandi NEVER holds funds — the Solana escrow contract does. Pabandi is the
// trust layer, agreement layer, and settlement orchestrator only.

model SecurityDeposit {
  id                  String   @id @default(cuid())
  tenantId            String // deposit payer (homeowner / lessee / HOA / resident)
  landlordId          String // deposit beneficiary (builder / fleet co / mgmt co / vendor)
  // Generalized context (was rentalType PROPERTY|CAR)
  depositContext      String   @default("PROPERTY") // PROPERTY | CAR | BUILDER | FLEET | HOA
  assetDescription    String // "123 Main St remodel" | "Fleet unit VIN xyz" | "Sunny Acres HOA repaving"
  requiredAmountUSD   Float
  tenantRiskBand      String // A | B | C | D | E (from PTP at booking)
  depositReductionPct Float    @default(0) // from PTP band (A=50%,B=30%,C=10%)
  // Additional reduction from verified BackgroundCheck on the beneficiary
  bcReductionPct      Float    @default(0) // up to 0.10 when beneficiary passes full BC
  bcCheckId           String? // BackgroundCheck.id used for the reduction
  actualDepositUSD    Float // requiredAmountUSD * (1 - depositReductionPct - bcReductionPct)
  yieldOptIn          Boolean  @default(false)
  communityPoolOptIn  Boolean  @default(false) // HOA: yield flows to community pool, not payer
  yieldAgreementId    String?  @unique
  escrowContract      String? // Solana escrow PDA / address (non-custodial)
  escrowTxHash        String?
  status              String   @default("PENDING") // PENDING | FUNDED | ACTIVE | RELEASED | DISPUTED | REFUNDED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  yieldAgreement YieldAgreement?    @relation(fields: [yieldAgreementId], references: [id])
  milestones     ProjectMilestone[]

  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
}

model YieldAgreement {
  id               String           @id @default(cuid())
  depositId        String           @unique
  tenantId         String
  landlordId       String
  securityDeposit  SecurityDeposit? @relation
  // Both parties sign — Pabandi is infra, not counterparty
  tenantSignedAt   DateTime?
  landlordSignedAt DateTime?
  // Yield pool config (tenant opts in; Pabandi takes spread, never principal risk)
  pool             String           @default("JITO_STSOL") // JITO_STSOL | ONDO_USDC | MAPLE
  expectedApy      Float            @default(7.0)
  tenantApy        Float            @default(5.5) // what tenant receives
  pabandiSpreadPct Float            @default(1.5) // fee taken from yield (NOT from principal)
  status           String           @default("PROPOSED") // PROPOSED | AGREED | ACTIVE | TERMINATED
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([landlordId])
}

// ── Renter Equity Wallet ─────────────────────────────────────────────────────
// The "rent is not a sunk cost" primitive. Yield earned on held rent/deposit
// accrues here, split 50/50 tenant/landlord. SIMULATED until an RWA adapter
// (Ondo USDY / Jito) is live; Pabandi never custodies principal.
model RenterEquityWallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  tenantEquity  Float    @default(0) // accrued yield owed to tenant
  landlordBonus Float    @default(0) // accrued yield owed to landlord (if this user is a landlord)
  totalSettled  Float    @default(0) // lifetime settled yield
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A single rent payment held in the yield-bearing rail for the float window.
model RentStream {
  id              String   @id @default(cuid())
  tenantId        String
  landlordId      String
  propertyId      String?
  rentAmountUSD   Float
  pool            String   @default("ONDO_USDC") // ONDO_USDC | JITO_STSOL | MAPLE
  expectedApy     Float    @default(4.5)
  holdingDays     Int      @default(4) // paid 1st, settles 5th
  // Computed at settlement
  totalYieldUSD   Float?
  tenantEquityUSD Float?
  landlordBonusUSD Float?
  pabandiSpreadUSD Float?
  status          String   @default("PENDING") // PENDING | SETTLED
  simulated       Boolean  @default(true) // true until on-chain RWA adapter live
  settledAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
}

// ── Court Check (CourtListener eviction / litigation screening) ─────────────────
// Persisted screening of a landlord or tenant against U.S. court records. Feeds the
// rental trust rail: the riskBand adjusts SecurityDeposit.tenantRiskBand / reduction.
model CourtCheck {
  id            String   @id @default(cuid())
  subjectType   String   @default("TENANT") // TENANT | LANDLORD
  name          String
  state         String?
  // CourtListener result snapshot
  found         Boolean  @default(false)
  count         Int      @default(0)
  recentEviction Boolean @default(false)
  riskBand      String   @default("LOW") // LOW | MEDIUM | HIGH
  source        String   @default("COURTLISTENER") // COURTLISTENER | PK_BACKGROUND | PK_FBR
  cases         Json?    // array of matched dockets (caseName, court, dateFiled, status)
  // Context
  reservationId String?
  businessId    String?
  customerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  business    Business?    @relation(fields: [businessId], references: [id])
  customer    User?        @relation(fields: [customerId], references: [id])

  @@index([reservationId])
  @@index([businessId])
  @@index([customerId])
  @@index([riskBand])
}

// ── ZK Proof Record (portable, verifiable history; no User FK so proofs persist
