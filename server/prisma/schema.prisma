model SMSLog {
  id          String    @id @default(cuid())
  businessId  String
  to          String
  message     String
  provider    String // TWILIO, VONAGE
  status      String    @default("PENDING")
  externalId  String?
  cost        Float?
  sentAt      DateTime?
  deliveredAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([provider])
}

model ChannelMessage {
  id          String    @id @default(cuid())
  businessId  String
  customerId  String
  channel     String // WHATSAPP, TELEGRAM, SMS
  direction   String // INCOMING, OUTGOING
  content     String
  status      String    @default("PENDING")
  externalId  String?
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model BusinessSmsProvider {
  id             String    @id @default(cuid())
  businessId     String    @unique
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// TWILIO | VONAGE
  provider       String
  /// AES-256-GCM blob. Written once, never read back to the client.
  credentials    String
  /// The sending number, held separately because it is displayed on every outbound
  /// message and so is safe to return — unlike the secret.
  fromNumber     String
  /// PENDING until verified against the provider, then VERIFIED or FAILED.
  status         String    @default("PENDING")
  lastError      String?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId])
  @@index([status])
}

model MerchantSubscription {
  id                 String    @id @default(cuid())
  /// UNIQUE, and load-bearing: the Business side is a one-to-one, which is what lets
  /// the fee engine read a merchant's tier without a query for duplicates.
  businessId         String    @unique
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// free | starter | pro | business
  tier               String    @default("free")
  status             String    @default("inactive")
  whopMembershipId   String?
  whopPlanId         String?
  whopCompanyId      String?
  priceCents         Int       @default(0)
  currency           String    @default("USD")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  lastWebhookId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([businessId, status])
  @@index([whopMembershipId])
  @@index([status])
}

