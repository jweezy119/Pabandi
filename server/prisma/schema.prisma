  commitment    String
  publicInputs  Json
  zkType        String   @default("noir-constraint")
  anchor        Json?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([proofId])
  @@index([entityId])
  @@index([component])
}

model BackgroundCheck {
