// ── Property Manager CRM + White Label ────────────────────────────────────────
// A property manager/landlord enrolls to get a CRM dashboard: their properties,
// tenant history, screening records, and disputes. White-label lets them offer
// a branded portal (their domain/slug) so tenants book through their own brand.

model PropertyManagerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  // What kind of business this CRM serves. Drives UI terminology + workflow.
  // PROPERTY_MANAGEMENT | SALES | SERVICE | FREELANCE | GENERAL
  businessType String  @default("GENERAL")
  // White-label portal: manager.brand.com or pabandi.com/p/:slug
  slug        String?  @unique
  domain      String?  @unique
  brandColor  String?  // hex, e.g. "#6366f1"
  logoUrl     String?
  tagline     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties PropertyManagerProperty[]
  tenants    PropertyTenant[]
  screenings PropertyScreening[]
  appointments PropertyAppointment[]
  leases     PropertyLease[]
  maintenance PropertyMaintenance[]
  webhooks   PropertyWebhook[]
  activities PropertyActivity[]
  applications     TenantApplication[]
  documents        TenantDocument[]

  @@index([userId])
}

// A property under a manager's portfolio (links to existing Property model).
model PropertyManagerProperty {
  id          String   @id @default(cuid())
  managerId   String
  propertyId  String?  // links to Property.id (optional, for discovery-linked)
  title       String
  address     String?
  city        String?
  state       String?
  zip         String?
  country     String   @default("United States")
  bedrooms    Int      @default(1)
  bathrooms   Float    @default(1)
  rentAmount  Float?
  rentPeriod  String   @default("MONTH") // MONTH | WEEK | NIGHT
  status      String   @default("VACANT") // VACANT | OCCUPIED | MAINTENANCE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager          PropertyManagerProfile @relation(fields: [managerId], references: [id], onDelete: Cascade)
  tenants          PropertyTenant[]
  screeningRecords PropertyScreening[]
  appointments     PropertyAppointment[]
  leases           PropertyLease[]
  maintenance      PropertyMaintenance[]
  applications     TenantApplication[]
  units            PropertyUnit[]
  rentPayments     RentPayment[]
  inspections      PropertyInspection[]
  financials       PropertyFinancial[]

  @@index([managerId])
  @@index([status])
}

// ── Deep Property-Specific Models ─────────────────────────────────────────────
// Individual units within a property (e.g. Unit 2A, Unit 3B).
model PropertyUnit {
  id          String   @id @default(cuid())
  propertyId  String
  unitNumber  String   // e.g. "2A", "3B"
  bedrooms    Int      @default(1)
  bathrooms   Float    @default(1)
  sqft        Int?
  rentAmount  Float?
  depositAmount Float  @default(0)
  status      String   @default("VACANT") // VACANT | OCCUPIED | MAINTENANCE | RESERVED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property PropertyManagerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   PropertyLease[]
  rentPayments RentPayment[]
  inspections  PropertyInspection[]
  financials   PropertyFinancial[]

  @@index([propertyId])
  @@index([status])
}

// Rent payment tracking for tenants.
model RentPayment {
  id          String   @id @default(cuid())
  propertyId  String
  unitId      String?
  tenantEmail String
  // Payment details.
  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  // Status: PENDING | PAID | LATE | PARTIAL
  status      String   @default("PENDING")
  // Payment method / reference.
  method      String?  // BANK_TRANSFER | CASH | CHECK | ONLINE
  reference   String?  // transaction reference
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property PropertyManagerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit      PropertyUnit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([tenantEmail])
  @@index([status])
  @@index([dueDate])
}

// Property inspection reports.
model PropertyInspection {
  id          String   @id @default(cuid())
  propertyId  String
  unitId      String?
  // Inspection details.
  inspectedAt DateTime @default(now())
  inspector   String?
  // Overall condition: EXCELLENT | GOOD | FAIR | POOR
  condition   String   @default("GOOD")
  notes       String?
  // Findings as JSON array [{ area, condition, notes, photos: [] }]
  findings    Json?
  createdAt   DateTime @default(now())

  property PropertyManagerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit      PropertyUnit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([inspectedAt])
}

// Tenant history for a property manager (past + current tenants).
model PropertyTenant {
  id              String    @id @default(cuid())
  managerId       String
  propertyId      String?
  // Tenant identity (email is the stable key for history lookup).
  email           String
  firstName       String?
  lastName        String?
  phone           String?
  // History: past stays, disputes, screening bands.
  status          String   @default("PROSPECT") // PROSPECT | APPLIED | APPROVED | ACTIVE | PAST | DENIED
  riskBand        String?  // LOW | MEDIUM | HIGH (from CourtCheck)
  depositHeld     Float    @default(0)
  totalStays      Int      @default(0)
  totalDisputes   Int      @default(0)
  lastStayAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manager  PropertyManagerProfile  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  property PropertyManagerProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenantApplications TenantApplication[]

  @@unique([managerId, email])
  @@index([managerId])
  @@index([email])
}

// Screening record for a tenant (CourtCheck US + PK rails).
model PropertyScreening {
  id              String   @id @default(cuid())
  managerId       String
  propertyId      String?
  tenantEmail     String
  tenantName      String?
  // Screening result.
  band            String   @default("LOW") // LOW | MEDIUM | HIGH
  depositAdjPct   Float    @default(0)     // 0 | 10 | 25
  screenedAt      DateTime @default(now())
  source          String   @default("COURTLISTENER") // COURTLISTENER | BACKGROUND_CHECK | MANUAL
  notes           String?
  createdAt       DateTime @default(now())

  manager  PropertyManagerProfile  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  property PropertyManagerProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([managerId])
  @@index([tenantEmail])
}

// Appointment/calendar scheduling for property showings.
model PropertyAppointment {
  id          String   @id @default(cuid())
  managerId   String
  propertyId  String?
  tenantEmail String
  tenantName  String?
  // When the showing is scheduled.
  startsAt    DateTime
  endsAt      DateTime?
  // Status: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
  status      String   @default("PENDING")
  notes       String?
  // Reminder sent flag.
  reminded    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager  PropertyManagerProfile  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  property PropertyManagerProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([managerId])
  @@index([startsAt])
  @@index([status])
}

// Lease tracking for a tenant at a property.
model PropertyLease {
  id            String   @id @default(cuid())
  managerId     String
  propertyId    String?
  unitId        String?
  tenantEmail   String
  tenantName    String?
  // Lease terms.
  startDate     DateTime
  endDate       DateTime
  rentAmount    Float
  rentPeriod    String   @default("MONTH") // MONTH | WEEK
  depositAmount Float    @default(0)
  // Detailed lease terms.
  petFee        Float    @default(0)     // one-time pet fee
  petMonthly    Float    @default(0)     // monthly pet rent
  lateFee       Float    @default(0)     // late payment fee
  lateGraceDays Int      @default(5)     // grace period in days
  utilities     String[] @default([])    // included utilities: WATER | ELECTRIC | GAS | INTERNET | TRASH
  // Renewal / termination.
  renewalTerms  String?                   // renewal terms
  terminationNoticeDays Int @default(30) // days notice required
  // Status: DRAFT | ACTIVE | EXPIRED | TERMINATED
  status        String   @default("DRAFT")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  manager  PropertyManagerProfile  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  property PropertyManagerProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit     PropertyUnit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  documents TenantDocument[]

  @@index([managerId])
  @@index([tenantEmail])
  @@index([status])
}

// Maintenance request for a property.
model PropertyMaintenance {
