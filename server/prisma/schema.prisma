// ── Milestone Draw model (construction / fleet phased release) ───────────────
model ProjectMilestone {
  id                 String    @id @default(cuid())
  depositId          String // FK to SecurityDeposit (the master escrow)
  // Phase definition
  name               String // "Framing", "Rough-in", "10% Retention"
  description        String?
  sequence           Int       @default(0) // draw order
  amountUSD          Float // funds released at this milestone
  // Gating conditions (all must be true to release)
  requiresLienWaiver Boolean   @default(false)
  requiresBcRefresh  Boolean   @default(false) // re-run BackgroundCheck on beneficiary
  requiresSignoff    Boolean   @default(true) // payer (homeowner/HOA) approval
  // Status
  status             String    @default("PENDING") // PENDING | FUNDED | RELEASED | DISPUTED
  releasedAt         DateTime?
  releasedTxHash     String?
  // Pay-on-verified-work: when released, worker is credited instantly
  creditedUserId     String? // resolved beneficiary wallet owner
  creditedUsdc       Float? // net amount credited after settlement bps
  settlementBps      Float? // bps taken as Pabandi revenue (vs ~700bps remittance)
  // Compliance artifacts
  lienWaiverUrl      String?
  bcCheckId          String? // BackgroundCheck.id from refresh
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deposit SecurityDeposit @relation(fields: [depositId], references: [id])

  @@index([depositId])
  @@index([status])
}

// ── WorkerPayout (payroll ledger: every milestone release = instant worker pay) ─
// The "remittance killer" engine: verified-work release -> worker USDC credited
// same block, settlement bps (0.5%) vs ~7% remittance. Trust-gated (band E blocked).
model WorkerPayout {
  id            String   @id @default(cuid())
  milestoneId   String
  depositId     String
  userId        String // worker who got paid
  grossUsdc     Float // milestone amount released
  settlementBps Float // bps Pabandi took
  feeUsdc       Float
  netUsdc       Float // credited to worker wallet
  status        String   @default("PAID") // PAID | REVERSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([depositId])
  @@index([milestoneId])
}

// ── Performance Bond (Pabond-underwritten; replaces/backs a deposit) ──────────
model PerformanceBond {
  id             String    @id @default(cuid())
  depositId      String // linked master escrow (bond may back the whole project)
  beneficiaryId  String // builder / fleet co / HOA vendor (who is bonded)
  payerId        String // homeowner / lessee / HOA (protected party)
  depositContext String    @default("BUILDER") // BUILDER | FLEET | HOA
  coverageUSD    Float // bond face value
  // Bond pricing from Pabond reputation curve
  premiumUSD     Float // cost of the bond (Pabandi revenue)
  velocityMult   Float     @default(1.0) // TrustFlux velocity multiplier
  status         String    @default("PROPOSED") // PROPOSED | ACTIVE | CLAIMED | EXPIRED
  claimedAt      DateTime?
  claimReason    String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([depositId])
  @@index([beneficiaryId])
  @@index([payerId])
}

// ── Community Pool (HOA yield → community amenities / reserves) ───────────────
model CommunityPool {
  id                  String           @id @default(cuid())
  communityName       String // "Sunny Acres HOA"
  // Wallet that receives the redirected yield
  treasuryWallet      String?
  totalDepositsUSD    Float            @default(0) // sum of deposits routed here
  totalYieldUSD       Float            @default(0) // cumulative yield earned
  totalDistributedUSD Float            @default(0) // paid out to community
  // Governance
  memberCount         Int              @default(0)
  publicDashboard     Boolean          @default(true) // transparency on
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  grants              CommunityGrant[]
}

// ── Community Grant (yield → community micro-grants / amenities) ─────────────
model CommunityGrant {
  id          String   @id @default(cuid())
  poolId      String
  title       String
  description String?
  amountUSD   Float
  status      String   @default("PROPOSED") // PROPOSED | APPROVED | FUNDED | COMPLETE
  approvedBy  String? // HOA member / vote
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pool CommunityPool @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@index([status])
}

// ── Trust Passport (public, portable provider trust identity) ───────────────
model TrustPassport {
  id            String    @id @default(cuid())
  handle        String    @unique // shareable slug, e.g. "apex-builders"
  agentId       String? // Web3Agent.id if linked
  providerRef   String? // string key used across deposits/bonds/BC (landlordId/beneficiaryId/subjectId)
  category      String    @default("FREELANCER") // FREELANCER | BUILDER | FLEET | HOA | PROPERTY_MANAGER
  displayName   String
  bio           String?
  walletAddress String?
  visibility    String    @default("PUBLIC") // PUBLIC | PRIVATE
  claimsCount   Int       @default(0) // times requested/verified
  riskScore     Int?
  riskBand      String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gigHistory   PassportGigHistory[]
  endorsements SkillEndorsement[]
  vector       PassportVector?

  @@index([handle])
  @@index([agentId])
  @@index([providerRef])
}

// ── Best Fit Engine (Behavioral Biometrics & Pattern Matching) ─────────────

model PassportGigHistory {
  id                 String   @id @default(cuid())
  passportId         String
  gigId              String? // Optional reference to external gig system
  title              String
  description        String?
  scheduledDate      DateTime
  locationHash       String? // Geohash (4+ chars) for privacy-preserving location
  zipCode            String?
  timeBucket         String // e.g., "0-6", "6-12", "12-18", "18-24"
  dayOfWeek          Int // 0-6 (Sunday-Saturday)
  status             String   @default("COMPLETED") // COMPLETED | CANCELLED | NO_SHOW
  clientRating       Int? // 1-5 stars
  leadTimeHours      Float? // Hours between gig creation and acceptance
  cancellationReason String? // Context for cancellations
  createdAt          DateTime @default(now())

  passport TrustPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)

  @@index([passportId])
  @@index([locationHash])
  @@index([timeBucket])
}

model SkillEndorsement {
  id         String   @id @default(cuid())
  passportId String
  skillName  String // e.g., "Plumbing", "Catering", "ReactJS"
  endorsedBy String? // Client or other verified user ID
  rating     Int      @default(5) // Quality rating of the skill
  weight     Float    @default(1.0) // Endorsement strength
  createdAt  DateTime @default(now())

  passport TrustPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)

  @@index([passportId])
  @@index([skillName])
}

model PassportVector {
  id             String   @id @default(cuid())
  passportId     String   @unique
  // TODO: migrate to pgvector when cosine similarity searches exceed 100ms or dataset > 50k vectors.
  // Stores a 1D array of floats representing temporal, spatial, and behavioral tendencies.
  behaviorVector Json     @default("[]")
  sampleCount    Int      @default(0) // Number of gigs used to build the vector
  lastUpdated    DateTime @updatedAt

  passport TrustPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
}

// ── OAuth-Like Delegated Access ("Sign in with Pabandi") ─────────────

model OAuthClient {
  id            String   @id @default(cuid())
  clientId      String   @unique // The public identifier for the app
  clientSecret  String // The hashed secret for back-channel calls
  name          String // Display name (e.g., "Rozee.pk", "Daraz")
  logoUrl       String?
  redirectUris  String[] // Allowed callback URLs
  webhookUrl    String?
  webhookSecret String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authCodes OAuthAuthCode[]
  tokens    OAuthToken[]
}

model OAuthAuthCode {
  id          String   @id @default(cuid())
  code        String   @unique
  clientId    String
  userId      String
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  used        Boolean  @default(false)

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String   @unique
  refreshToken String?  @unique
  clientId     String
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revoked      Boolean  @default(false)

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([accessToken])
}

// ── AgentStake (skin-in-the-game gate for the recommendation engine) ────────────
// Agents must stake >= STAKE_REQUIRED_PAB to be indexed by agentScorer. Slashing
// decrements amountPab + increments slashedPab. On-chain lock/burn handled by the
// stakeSlashing service; this is the ledger source of truth.
model AgentStake {
  id         String   @id @default(cuid())
  agentId    String   @unique
  amountPab  Float    @default(0)
  slashedPab Float    @default(0)
  vault      String // protocol stake vault (PAB treasury)
  indexed    Boolean  @default(false) // true once stake >= required
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent Web3Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([indexed])
}

// ── Project (autogen pipeline → posted project with idle-yield vault) ─────────────
model Project {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String
  requiredSkills  String[] // e.g. ["Rust","Anchor"]
  budgetUsd       Float
  estimatedHours  Int      @default(0)
  demandGrowthPct Float    @default(0)
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | DELIVERED | CANCELLED
  vaultUsdc       Float    @default(0) // idle capital routed to Kamino Lend (phase 2)
  yieldEarnedUsdc Float    @default(0) // accrued float yield (phase 2)
  bestAgentId     String? // chosen by recommendation engine
  bestConfidence  Float? // confidence % of the recommendation
  createdBy       String?  // owner userId / app id for webhook routing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bids ProjectBid[]

  @@index([status])
  @@index([category])
}

// ── ProjectBid (agent auto-bid on a project) ─────────────────────────────────────
model ProjectBid {
  id            String   @id @default(cuid())
  projectId     String
  agentId       String
  confidencePct Float // scorer output at bid time
  quoteUsd      Float
  stakePab      Float    @default(0) // PAB staked as trust bond (held, slashed on no-show, returned+bonus on delivery)
  status        String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  breakdown     Json? // scorer ScoreBreakdown for transparency
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([agentId])
}

// ── GigEvent (durable activity ledger: survives cold starts; powers board counters/feed) ──
model GigEvent {
  id           String   @id @default(cuid())
  kind         String // POST | CLAIM | COMPLETE
  role         String // project-owner | freelancer
  gigId        String
  source       String   @default("human") // human | ai-loop
  skill        String?
  budgetUsd    Float?
  category     String?
  claimedBy    String?
  rakeSol      Float?
  helperSol    Float?
  referralCode String?
  createdAt    DateTime @default(now())

  @@index([gigId])
  @@index([kind])
  @@index([source])
}

// ── Program: a long, multi-task engagement (up to a year) decomposed + budgeted into tasks ──
//  Each task becomes a budgeted mini-gig with its own milestone escrow, so no single party
//  carries full-program risk and the "right freelancer" is matched per task.
model Program {
  id             String        @id @default(cuid())
  title          String
  description    String?
  clientWallet   String?
  referralCode   String?
  durationWeeks  Int           @default(52)
  totalBudgetUsd Float
  taskCount      Int
  status         String        @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  createdAt      DateTime      @default(now())
  tasks          ProgramTask[]
}

model ProgramTask {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  seq             Int // 1..N order
  title           String
  skill           String
  category        String
  budgetUsd       Float
  estimatedHours  Int
  gigId           String? // the resulting gig once staffed
  assignedAgentId String?
  status          String   @default("PLANNED") // PLANNED | OPEN | IN_PROGRESS | COMPLETED
  createdAt       DateTime @default(now())

  @@index([programId])
  @@index([status])
}

// Pre-registration interest for the Ondo USDY rent-yield rail (marketing/flywheel).
// Captures landlord/property-manager intent BEFORE the rail goes live, so Pabandi can
// show Ondo a growing, verifiable list of properties wanting tokenized-T-bill rent yield.
model UsdyLead {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  propertyType String? // hotel | guesthouse | vacation_rental | serviced_apartment | other
  portfolioSize Int?    // number of units/properties the lead manages
  country      String?
  message      String?
  source       String   @default("usdy_landing") // where the lead came from
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([country])
}

// ── PAB Arcade Token Economy ─────────────────────────────────────────────────
// PAB is an arcade-token: earn by doing things, spend on services, stake for tiers.
// Zero capital needed — issued as users earn it, burned as they spend it.

model PabWallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Float    @default(0)
  totalEarned Float    @default(0)
  totalSpent  Float    @default(0)
  totalBurned Float    @default(0)
  stakedAmt   Float    @default(0)
  stakedTier  String?
  stakedAt    DateTime?
  stakeExpires DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PabTransaction[]

  @@index([userId])
  @@index([stakedTier])
}

model PabTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String
  amount      Float
  action      String
  description String
  refType     String?
  refId       String?
  balanceAfter Float
  createdAt   DateTime @default(now())

  wallet PabWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([action])
  @@index([createdAt])
}

model PabEarnRule {
  id          String   @id @default(cuid())
  action      String   @unique
  amount      Float
  description String
  isActive    Boolean  @default(true)
  cooldownHours Int    @default(0)
  dailyCap    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PabSpendRule {
  id          String   @id @default(cuid())
  action      String   @unique
  cost        Float
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PabStakeTier {
  id          String   @id @default(cuid())
  tier        String   @unique
  minStake    Float
  durationDays Int
  benefit     String
  feeDiscount Float    @default(0)
  searchBoost Boolean  @default(false)
  badge       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PabTreasury {
  id          String   @id @default(cuid())
  totalSolEarned Float @default(0)
  totalSolToPool Float @default(0)
  totalPabBurned Float @default(0)
  totalPabStaked Float @default(0)
  poolSolBalance Float @default(0)
  poolUsdcBalance Float @default(0)
  updatedAt   DateTime @updatedAt
}

// ── Marketplace: Buy, Sell, Rent, Hire ───────────────────────────────────────
// Unified marketplace for physical items, property rentals, and service providers.

model MarketplaceListing {
  id            String   @id @default(cuid())
  sellerId      String?  // User.id (optional for guest listings)
  sellerEmail   String
  sellerName    String?
  // What kind of listing this is.
  type          ListingType @default(ITEM)
  // Item details.
  title         String
  description   String?
  category      String   // furniture | electronics | appliances | clothing | sports | other
  condition     String   // NEW | LIKE_NEW | GOOD | FAIR | POOR
  price         Float
  currency      String   @default("USD")
  // Location.
  city          String?
  state         String?
  zip           String?
  latitude      Float?
  longitude     Float?
  // Photos.
  imageUrls     String[] @default([])
  // Status: ACTIVE | SOLD | RESERVED | EXPIRED | DELETED.
  status        String   @default("ACTIVE")
  // Escrow protection.
  escrowEnabled Boolean  @default(true)
  escrowId      String?  // LocalSaleEscrow.id when funded
  // Reservation / booking fields (for rental/service listings).
  availableFrom DateTime?
  availableTo   DateTime?
  // Engagement.
  viewCount     Int      @default(0)
  favoriteCount Int      @default(0)
  // Tags for search.
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seller User? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  bookings MarketplaceBooking[]

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([city])
  @@index([sellerId])
  @@index([price])
  @@index([createdAt])
}

enum ListingType {
  ITEM     // physical item for sale
  RENTAL   // property/apartment rental
  SERVICE  // freelancer/service provider
  WANTED   // buyer looking for something
}

model MarketplaceBooking {
  id           String   @id @default(cuid())
  listingId    String
  buyerId      String?
  buyerEmail   String
  buyerName    String?
  // When.
  scheduledAt  DateTime
  // Status: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW.
  status       String   @default("PENDING")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerEmail])
  @@index([status])
}


// ── Promo Ambassador ZK Trust System ─────────────────────────────────────────
// Brands post jobs, ambassadors do work, reviews are verified via ZK proofs
// so companies see real reputation without exposing which ambassador said what.

model PromoAmbassador {
  id              String   @id @default(cuid())
  userId          String?  @unique
  handle          String   @unique // public pseudonym
  workType        String   // SOCIAL_MEDIA | EVENTS | CONTENT | DELIVERY | SURVEY | OTHER
  bio             String?
  portfolioUrl    String?
  verifiedBadges  String[] @default([]) // e.g. ["TOP_10_PERCENT", "FAST_DELIVERY"]
  reputationScore Float    @default(50) // 0-100
  totalJobs       Int      @default(0)
  completedJobs   Int      @default(0)
  totalEarnings   Float    @default(0) // USD
  zkPublicKey     String?  // for ZK proof verification
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     PromoSubmission[]
  reviews         PromoReview[]

  @@index([workType])
  @@index([reputationScore])
  @@index([active])
}

model PromoJob {
  id              String   @id @default(cuid())
  brandId         String?  // brand/company that posted
  brandName       String?  // display name (can be anonymous)
  title           String
  description     String
  workType        String   // SOCIAL_MEDIA | EVENTS | CONTENT | DELIVERY | SURVEY | OTHER
  budgetUsd       Float
  deadline        DateTime?
  requirements    String[] @default([]) // e.g. ["MIN_REPUTATION_70", "VERIFIED_BADGE"]
  maxAmbassadors  Int      @default(1)
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | CANCELLED
  zkRequired      Boolean  @default(true) // require ZK proof for submission
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     PromoSubmission[]

  @@index([workType])
  @@index([status])
  @@index([brandId])
}

model PromoSubmission {
  id              String   @id @default(cuid())
  jobId           String
  ambassadorId    String
  contentUrl      String?  // link to work (post, video, etc.)
  description     String?
  status          String   @default("SUBMITTED") // SUBMITTED | ACCEPTED | REJECTED | DISPUTED
  zkProofId       String?  // ZK proof of work completion
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewNotes     String?

  job             PromoJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ambassador      PromoAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([ambassadorId])
  @@index([status])
}

model PromoReview {
  id              String   @id @default(cuid())
  submissionId    String   @unique
  ambassadorId    String
  rating          Int      // 1-5
  text            String?
  // ZK fields — review is verified without exposing ambassador identity to brand
  zkProofId       String?  // ZK proof that reviewer is a real ambassador
  zkCommitment    String?  // commitment hash (hides ambassadorId)
  workType        String   // grouped by work type for brand insights
  verified        Boolean  @default(false) // ZK proof verified
  createdAt       DateTime @default(now())

  ambassador      PromoAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId])
  @@index([workType])
  @@index([verified])
  @@index([rating])
}
