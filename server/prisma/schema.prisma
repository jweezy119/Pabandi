  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  notes             String?
  customData        Json?
  clientId          String?
  ownerName         String?
  businessId        String?
  serviceBusinessId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

