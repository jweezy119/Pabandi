generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  phone                   String?                 @unique
  passwordHash            String
  firstName               String
  lastName                String
  role                    UserRole                @default(CUSTOMER)
  isEmailVerified         Boolean                 @default(false)
  isPhoneVerified         Boolean                 @default(false)
  verificationCode        String?                 // 6-digit email verification code
  verificationCodeExpires DateTime?               // Code expiration timestamp
  reliabilityScore        Float                   @default(750)
  trustScore              Float                   @default(50.0)
  minimumSellerTrustScore Int                     @default(0)
  verificationTier        String                  @default("BASIC")
  commerceScore           Float                   @default(50.0)
  hospitalityScore        Float                   @default(50.0)
  freelanceScore          Float                   @default(50.0)
  appointmentScore        Float                   @default(50.0)
  osintLastChecked        DateTime?
  firstOffenseGraceUsed   DateTime?
  gracePeriodUntil        DateTime?
  fcmToken                String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  googleId                String?                 @unique
  facebookId              String?                 @unique
  resetToken              String?
  resetTokenExpires       DateTime?
  linkedinId              String?                 @unique
  profilePictureUrl       String?
  tiktokId                String?                 @unique
  twitterId               String?                 @unique
  walletAddress           String?                 @unique
  stripeCustomerId        String?
  bountyPaid              Boolean                 @default(false)
  nonce                   String?
  referredById            String?
  business                Business?
  cryptoRewards           CryptoReward[]
  payments                Payment[]
  reservations            Reservation[]
  socialIdentities        SocialIdentity[]
  referredBy              User?                   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals               User[]                  @relation("UserReferrals")
  wallet                  Wallet?
  stakeTransactions       StakeTransaction[]
  stakingPositions        StakingPosition[]
  loans                   Loan[]
  payouts                 Payout[]
  workerPayouts           WorkerPayout[]
  oauthAuthCodes          OAuthAuthCode[]
  oauthTokens             OAuthToken[]
  virtualAccounts         VirtualAccount[]
  disputesAgainst         Dispute[]               @relation("DisputesAgainst")
  disputesFiled           Dispute[]               @relation("DisputesFiled")
  flags                   UserFlag[]
  deviceFingerprint       String?
  failedLoginAttempts     Int                     @default(0)
  accountLockedUntil      DateTime?
  trustAudits             TrustAuditTrail[]
  pabandiReviews          PabandiReview[]
  encryptedDietaryData    String?
  profileChangeRequests   ProfileChangeRequest[]
  passportScoreSnapshots  PassportScoreSnapshot[]
  whatsappSignals         WhatsAppChannelSignal[]
  socialGraphSignals      SocialGraphSignal[]
  web3Stakes               Web3StakeRecord[]
  AccountManagerProfile   AccountManagerProfile?
  verifiableCredentials   VerifiableCredential[]
  renterEquityWallets     RenterEquityWallet[]
  courtChecks             CourtCheck[]
  propertyManagerProfile  PropertyManagerProfile?
  marketplaceListings    MarketplaceListing[]
  pabWallet              PabWallet?

  @@index([email])
  @@index([phone])
}

model Business {
  id                     String                  @id @default(cuid())
  ownerId                String?                 @unique
  name                   String
  stripeAccountId        String?                 @unique
  description            String?
  category               BusinessCategory
  address                String
  city                   String                  @default("")
  country                String                  @default("United States")
  postalCode             String?
  phone                  String
  email                  String
  website                String?
  logoUrl                String?
  coverImageUrl          String?
  latitude               Float?
  longitude              Float?
  timezone               String                  @default("America/New_York")
  currency               String                  @default("USD")
  bookingAdvanceDays     Int                     @default(30)
  cancellationHours      Int                     @default(24)
  requireDeposit         Boolean                 @default(false)
  depositAmount          Float?
  depositPercentage      Float?
  isVerified             Boolean                 @default(false)
  isActive               Boolean                 @default(true)
  isPremium              Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  googlePlaceId          String?
  rating                 Float?
  reviewCount            Int                     @default(0)
  reliabilityScore       Float?
  karmaScore             Float                   @default(50.0)
  businessTier           String                  @default("STANDARD")
  trustScore             Float                   @default(50.0)
  state                  String                  @default("")
  isClaimed              Boolean                 @default(true)
  externalBookingUrl     String?
  slug                   String?                 @unique
  verifiedAt             DateTime?
  deviceFingerprint      String?
  externalDetails        Json?
  source                 String?
  externalId             String?
  checkInTime            String?
  checkOutTime           String?
  channexPropertyId      String?                 @unique
  owner                  User?                   @relation(fields: [ownerId], references: [id])
  businessHours          BusinessHours[]
  settings               BusinessSettings?
  googleReviews          GoogleReview[]
  reservations           Reservation[]
  sourcingOrders         SourcingOrder[]
  tables                 Table[]
  trendSuggestions       TrendSuggestion[]
  webhookEndpoints       WebhookEndpoint[]
  pabandiReviews         PabandiReview[]
  services               BusinessService[]
  liveSellerIntegrations LiveSellerIntegration[]
  checkoutSessions       CheckoutSession[]
  shopifyStores          ShopifyStore[]
  apiClients             ApiClient[]
  referredById           String?
  bountyPaid             Boolean                 @default(false)
  referredBy             AccountManagerProfile?  @relation(fields: [referredById], references: [id])
  Property               Property[]
  OpenFinanceConnection  OpenFinanceConnection[]
  courtChecks            CourtCheck[]

  @@index([ownerId])
  @@index([city])
  @@index([category])
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Table {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  capacity     Int
  isActive     Boolean       @default(true)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Reservation {
  id                  String               @id @default(cuid())
  businessId          String
  customerId          String
  tableId             String?
  reservationDate     DateTime
  checkOutDate        DateTime?
  reservationTime     String
  numberOfGuests      Int
  status              ReservationStatus    @default(PENDING)
  customerName        String
  customerPhone       String
  customerEmail       String?
  specialRequests     String?
  noShowProbability   Float?
  riskScore           Int?
  aiFactors           Json?
  reminderSentAt      DateTime?
  confirmationSentAt  DateTime?
  depositRequired     Boolean              @default(false)
  depositAmount       Float?
  depositPaid         Boolean              @default(false)
  source              String?
  trustSignals        Json?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cancelledAt         DateTime?
  cryptoDepositTxHash String?
  channexBookingId    String?              @unique
  rewardEarned        Float?               @default(0)
  googleReviewId      String?
  depositStatus       DepositStatus        @default(NOT_REQUIRED)
  conciergeDetails    Json?
  isConcierge         Boolean              @default(false)
  totalAmount         Float?
  cryptoRewards       CryptoReward[]
  payments            Payment[]
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  table               Table?               @relation(fields: [tableId], references: [id])
  services            ReservationService[]
  solanaAttestationId String?              @unique
  dispute             Dispute?
  StayBooking         StayBooking?
  courtChecks         CourtCheck[]

  @@index([businessId])
  @@index([customerId])
  @@index([reservationDate])
  @@index([status])
  @@index([businessId, reservationDate])
}

// ── Hospitality vertical (stays / short-term rentals / Airbnb-style) ──────────
model Property {
  id                  String           @id @default(cuid())
  businessId          String
  ownerId             String? // business owner user (for auth)
  title               String
  description         String?
  city                String           @default("")
  address             String?
  country             String           @default("United States")
  category            BusinessCategory @default(PROPERTY_RENTAL)
  pricePerNight       Float            @default(0)
  currency            String           @default("USD")
  maxGuests           Int              @default(2)
  bedrooms            Int              @default(1)
  coverImageUrl       String?
  amenities           String[] // e.g. ["wifi","kitchen","pool"]
  isActive            Boolean          @default(true)
  slug                String?          @unique
  latitude            Float?
  longitude           Float?
  // Open-finance settlement rail linked to this property's payouts.
  financeConnectionId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financeConnection OpenFinanceConnection? @relation(fields: [financeConnectionId], references: [id])
  bookings          StayBooking[]

  @@index([businessId])
  @@index([city])
  @@index([category])
}

// A confirmed stay = a Reservation (existing model) + a Property + a guest deposit escrow.
model StayBooking {
  id            String            @id @default(cuid())
  reservationId String            @unique
  propertyId    String
  guestUserId   String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int               @default(1)
  pricePerNight Float
  totalAmount   Float
  depositAmount Float             @default(0) // guest deposit held in escrow
  depositStatus DepositStatus     @default(NOT_REQUIRED)
  escrowTxHash  String? // Solana/chain tx when funded (simulated flag otherwise)
  status        ReservationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([guestUserId])
}

// ── Open Finance connectivity: verifiable link between a business and its
//    settlement rail (RAAST / Stripe Treasury / Open Banking / Solana wallet).
//    This is the "open finance" primitive — portable, attestable, no bank lock-in. ──
model OpenFinanceConnection {
  id           String    @id @default(cuid())
  businessId   String
  provider     String // RAAST | STRIPE_TREASURY | OPEN_BANKING | SOL_WALLET | PAYPAL
  accountRef   String // masked/opaque reference (e.g. IBAN tail, wallet addr, stripe acct id)
  status       String    @default("PENDING") // PENDING | VERIFIED | FAILED
  // Optional signed attestation that the rail is live (verifiable offline via PTP).
  attestation  Json?
  lastVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([businessId])
  @@index([provider])
}

model Payment {
  id                String        @id @default(cuid())
  reservationId     String?
  userId            String
  amount            Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  paymentMethod     String
  transactionId     String?       @unique
  gatewayResponse   Json?
  refunded          Boolean       @default(false)
  refundedAt        DateTime?
  refundAmount      Float?
  platformFeeAmount Float?
  platformFeeStatus String?       @default("NONE")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reservation       Reservation?  @relation(fields: [reservationId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

model BusinessSettings {
  id                          String   @id @default(cuid())
  businessId                  String   @unique
  autoConfirm                 Boolean  @default(true)
  requirePhone                Boolean  @default(true)
  requireEmail                Boolean  @default(false)
  allowSameDayBooking         Boolean  @default(true)
  maxAdvanceBookingDays       Int      @default(30)
  minBookingNoticeHours       Int      @default(2)
  aiEnabled                   Boolean  @default(true)
  aiRiskThreshold             Int      @default(70)
  autoRequireDeposit          Boolean  @default(false)
  sendEmailReminders          Boolean  @default(true)
  reminderHoursBefore         Int      @default(24)
  sendPushReminders           Boolean  @default(true)
  sendWhatsAppReminders       Boolean  @default(true)
  notifyOwnerOnNewBooking     Boolean  @default(true)
  whatsappNumber              String?
  whatsappInstanceId          String?
  requestFeedbackAfterBooking Boolean  @default(true)
  isE2eeEnabled               Boolean  @default(false)
  e2eePublicKey               String?
  houseRules                  String?  @db.Text
  cancellationPolicy          String?  @db.Text
  faqRules                    Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  business                    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model NotificationLog {
  id            String    @id @default(cuid())
  reservationId String
  type          String
  recipient     String
  subject       String?
  message       String
  status        String
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([reservationId])
  @@index([status])
}

model Wallet {
  id               String    @id @default(cuid())
  userId           String    @unique
  address          String?
  encryptedSecret  String? // Base64 encoded encrypted Solana Secret Key
  balance          Float     @default(0)
  totalStaked      Float     @default(0)
  lockedPab        Float     @default(0)
  usdcBalance      Float     @default(0)
  currency         String    @default("PAB")
  airdropClaimed   Boolean   @default(false)
  airdropAmount    Float?
  airdropClaimedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CryptoReward {
  id            String       @id @default(cuid())
  userId        String
  reservationId String?
  amount        Float
  type          String
  status        String       @default("CLAIMABLE")
  txHash        String?
  createdAt     DateTime     @default(now())
  metadata      Json?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleReview {
  id             String   @id @default(cuid())
  businessId     String
  googleReviewId String   @unique
  authorName     String
  rating         Int
  text           String?
  time           DateTime
  sentimentLabel String?
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model WebhookEndpoint {
  id               String   @id @default(cuid())
  businessId       String
  targetUrl        String
  subscribedEvents String[]
  isActive         Boolean  @default(true)
  signingSecret    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  appId         String
  event         String
  payload       Json
  status        String   @default("QUEUED") // QUEUED | DELIVERED | FAILED | SKIPPED
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([appId, status])
  @@index([createdAt])
}

model ApiClient {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  apiKey            String        @unique
  tier              ApiTier       @default(STARTER)
  callsUsed         Int           @default(0)
  callsLimit        Int           @default(500)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paymentMethod     String?
  transactionHash   String?       @unique
  walletAddress     String?
  businessId        String?
  billingMode       BillingMode   @default(PAY_AS_YOU_GO)
  preferredCurrency CurrencyType  @default(PAB)
  usageLogs         ApiUsageLog[]
  disputes          Dispute[]

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([apiKey])
  @@index([email])
  @@index([businessId])
}

model AppConnection {
  id           String   @id @default(cuid())
  appName      String
  ownerUserId  String
  bearerToken  String?  // PTP attestation base64 (masked in responses)
  scopes       String[]
  webhookUrl   String?
  redirectUrl  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerUserId])
}

model ApiUsageLog {
  id         String    @id @default(cuid())
  clientId   String
  endpoint   String
  statusCode Int
  latencyMs  Int
  createdAt  DateTime  @default(now())
  costCrypto Float     @default(0)
  costFiat   Float     @default(0)
  client     ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
}

model SocialIdentity {
  id             String         @id @default(cuid())
  userId         String
  platform       SocialPlatform
  platformHandle String?
  accountAgeDays Int?
  isVerified     Boolean        @default(false)
  completeness   Float?
  rating         Float?
  completionRate Float?
  accountLevel   String?
  trustBoost     Float          @default(0.0)
  connectedAt    DateTime       @default(now())
  lastRefreshed  DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

model LiveSellerIntegration {
  id           String             @id @default(cuid())
  businessId   String
  platform     LiveSellerPlatform
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  shopId       String?
  streamKey    String?
  webhookUrl   String?
  isActive     Boolean            @default(true)
  lastSyncAt   DateTime?
  metadata     Json?
  connectedAt  DateTime           @default(now())
  revokedAt    DateTime?
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
  @@index([businessId])
}

model SourcingOrder {
  id               String              @id @default(cuid())
  businessId       String
  items            Json
  status           SourcingOrderStatus @default(SUGGESTED)
  estimatedCostPKR Float
  accioWorkOrderId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model TrendSuggestion {
  id                    String      @id @default(cuid())
  businessId            String
  equipmentName         String
  description           String
  estimatedCostPKR      Float
  suggestedServicePrice Float
  projectedBookings     Int
  projectedRoiPercent   Float
  status                TrendStatus @default(SUGGESTED)
  accioWorkUrl          String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  business              Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum UserRole {
  BUSINESS_OWNER
  BUSINESS_STAFF
  CUSTOMER
  ADMIN
  FREELANCER
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  PENDING_CONCIERGE
  FAILED_CONCIERGE
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  PENDING_WEB3
  PAID
  APPLIED_TO_SERVICE
  REIMBURSED_TO_BUSINESS
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  JAZZCASH
  EASYPAISA
  CASH
  CRYPTO
  STRIPE
}

enum BusinessCategory {
  RESTAURANT
  SALON
  SPA
  CLINIC
  FITNESS_CENTER
  EVENT_VENUE
  HOTEL
  PROPERTY_RENTAL
  OTHER
  HOSPITAL
  FREELANCE
  ECOMMERCE
  MARKETPLACE
  LIVE_SELLER
}

enum LiveSellerPlatform {
  TIKTOK_LIVE
  YOUTUBE_SHOPPING
  SHOPIFY_LIVE
  EBAY_LIVE
  AMAZON_LIVE
  INSTAGRAM_LIVE
  CUSTOM_WEB
}

enum ApiTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum BillingMode {
  PAY_AS_YOU_GO
  MONTHLY_SUBSCRIPTION
}

enum CurrencyType {
  FIAT
  PAB
}

enum SocialPlatform {
  LINKEDIN
  X_TWITTER
  WHATSAPP
  TIKTOK
  FACEBOOK
  FIVERR
  UPWORK
  INSTAGRAM
  INSTAGRAM_SHOP
  SHOPIFY
  WEB3_EVM
  WEB3_SOLANA
}

enum SourcingOrderStatus {
  SUGGESTED
  ORDERED
  SHIPPED
  FULFILLED
  CANCELLED
}

enum TrendStatus {
  SUGGESTED
  SOURCED
  SERVICE_LAUNCHED
  DISMISSED
}

model StakeTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      String // 'STAKE' or 'UNSTAKE'
  apyAtTime Float?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StakingPosition {
  id        String   @id @default(cuid())
  userId    String
  amount    Float // Amount of PAB staked
  status    String   @default("ACTIVE") // 'ACTIVE', 'WITHDRAWN'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TreasuryPosition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bucket    String // OPERATING | TREASURY | LP_PROVISION | YIELD_REINVEST | EMERGENCY
  kind      String? // HOSPITALITY | REALESTATE | ESCROW | RAKED | REFERRAL | default null
  amount    Float
  txHash    String?
  status    String   @default("PENDING") // PENDING | DEPLOYED | REPATRIATED
  meta      Json?

  @@index([bucket])
  @@index([status])
}

model VirtualAccount {
  id            String   @id @default(cuid())
  userId        String
  routingNumber String
  accountNumber String
  bankName      String
  currency      String   @default("USD")
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED
  provider      String // e.g. "SIMULATOR", "MELD", "STRIPE"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

// ── Payout (cash-out earned USDC to local bank / Connect account) ──────────────
// The "remittance killer": a verified worker cashes out instantly at a flat fee
// (1.5%) vs ~7% traditional remittance. Trust-gated (band E blocked).
model Payout {
  id              String   @id @default(cuid())
  userId          String
  amountUsdc      Float
  feeUsdc         Float
  netUsdc         Float // amount - fee actually delivered
  method          String   @default("BANK") // BANK | CONNECT
  destinationRef  String? // VirtualAccount id, Stripe Connect acct, or OFFRAMP:<intentId>
  offrampIntentId String? // linked OfframpIntent when method=LOCAL
  status          String   @default("SETTLED") // PENDING | SETTLED | FAILED
  txHash          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Dispute {
  id               String          @id @default(cuid())
  userId           String?
  hashedIdentityId String?
  reportedById     String?
  apiClientId      String?
  type             DisputeType
  description      String?
  outcome          DisputeOutcome  @default(PENDING)
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  stakedAmount     Float           @default(0)
  reservationId    String?         @unique
  // #3 Dispute Arbitration: attach disputes to paid-work contexts (not just reservations)
  contextType      String? // MILESTONE | OFFRAMP | PAYOUT | RESERVATION
  contextId        String? // ProjectMilestone.id | OfframpIntent.id | Payout.id
  evidenceUrls     String[]
  user             User?           @relation("DisputesAgainst", fields: [userId], references: [id], onDelete: Cascade)
  hashedIdentity   HashedIdentity? @relation(fields: [hashedIdentityId], references: [hash], onDelete: Cascade)
  reporter         User?           @relation("DisputesFiled", fields: [reportedById], references: [id])
  apiClient        ApiClient?      @relation(fields: [apiClientId], references: [id])
  reservation      Reservation?    @relation(fields: [reservationId], references: [id])
  votes            JuryVote[]

  @@index([userId])
  @@index([hashedIdentityId])
  @@index([apiClientId])
  @@index([contextType, contextId])
}

