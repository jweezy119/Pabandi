  // Which events to send: screening, tenant, appointment, lease, maintenance, all
  events      String[] @default(["all"])
  active      Boolean  @default(true)
  // Delivery tracking.
  lastDeliveredAt DateTime?
  lastStatus  String?  // 200, 404, 500, etc.
  failCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager PropertyManagerProfile @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId])
}

// Activity audit log for all CRM actions (who did what, when).
// Tenant application workflow (tenant applies to a listing).
model TenantApplication {
  id              String   @id @default(cuid())
  managerId       String
  propertyId      String?
  tenantId        String?
  // Applicant identity.
  email           String
  firstName       String?
  lastName        String?
  phone           String?
  // Application details.
  message         String?
  desiredMoveIn   DateTime?
  monthlyIncome   Float?
  // Status: SUBMITTED | UNDER_REVIEW | SCREENING | APPROVED | DENIED | WITHDRAWN
  status          String   @default("SUBMITTED")
  // Screening result (filled when manager runs CourtCheck).
