generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// CORE ENUMS
// ══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  FREELANCER
  OPERATOR
  ADMIN
}

enum PayoutMethod {
  WALLET
  BANK_ESFCA
  RAAST
  IBAN
  JAZZCASH
  EASYPAISA
}

enum ProfileType {
  CLIENT
  FREELANCER
  BUSINESS
  CONTRACTOR
  SERVICE_BUSINESS
  SOLO_BUILDER
}

enum UserMode {
  CUSTOMER
  BUSINESS
  FREELANCER
}

enum BusinessCategory {
  SALON
  BARBERSHOP
  SPA
  RESTAURANT
  CAFE
  FITNESS
  FITNESS_CENTER
  HEALTHCARE
  PROFESSIONAL
  RETAIL
  FREELANCE
  CLEANING
  CLINIC
  ROOFING
  HVAC
  SECURITY
  CONTRACTOR
  HOTEL
  PROPERTY_RENTAL
  OTHER
}

enum CheckoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  PAID
  FUNDED
  RELEASED
  CANCELLED
  DISPUTED
}

enum WorkOrderStatus {
  DRAFT
  PENDING_ASSIGNMENT
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ESCALATED
}

enum Priority {
  EMERGENCY
  URGENT
  ROUTINE
}

enum InvoiceStatus {
  NOT_READY
  READY
  INVOICED
  PAID
  draft
  sent
  paid
  overdue
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DisputeType {
  NO_SHOW
  POOR_SERVICE
  UNAUTHORIZED_CHARGE
  CANCELLATION_POLICY
  LATE_ARRIVAL
  DAMAGED_PROPERTY
  OTHER
}

enum DisputeOutcome {
  PENDING
  REFUNDED
  MERCHANT_FAVORED
  SPLIT
  CANCELLED
}

// ══════════════════════════════════════════════════════════════════════════════
// 1. IDENTITY & ACCOUNTS DOMAIN (User, Business, TrustPassport)
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id                      String        @id @default(cuid())
  email                   String        @unique
  phone                   String?       @unique
  passwordHash            String
  firstName               String
  lastName                String
  companyName             String?
  role                    UserRole      @default(CUSTOMER)
  profileType             ProfileType?
  payoutMethod            PayoutMethod?
  payoutAccountRef        String?
  isPayoutVerified        Boolean       @default(false)
  payoutVerifiedAt        DateTime?
  isEmailVerified         Boolean       @default(false)
  isPhoneVerified         Boolean       @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  reliabilityScore        Float         @default(50)
  trustScore              Float         @default(70.0)
  disputeRate             Float         @default(0.0)
  minimumSellerTrustScore Int           @default(0)
  verificationTier        String        @default("BASIC")
  fcmToken                String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  googleId                String?       @unique
  facebookId              String?       @unique
  githubId                String?       @unique
  telegramId              String?       @unique
  resetToken              String?
  resetTokenExpires       DateTime?
  linkedinId              String?       @unique
  profilePictureUrl       String?
  tiktokId                String?       @unique
  twitterId               String?       @unique
  walletAddress           String?       @unique
  stripeCustomerId        String?
  pabBalance              Float         @default(0)
  usdcBalance             Float         @default(0)
  activeMode              UserMode      @default(CUSTOMER)
  preferredMode           String        @default("business")
  username                String?       @unique
  bio                     String?
  tagline                 String?
  location                String?
  websiteUrl              String?
  avatarUrl               String?
  bannerUrl               String?
  bannerColor             String?       @default("#C97B5A")
  failedLoginAttempts     Int           @default(0)
  accountLockedUntil      DateTime?
  gracePeriodUntil        DateTime?
  nonce                   String?
  commerceScore           Float?        @default(70.0)
  hospitalityScore        Float?        @default(70.0)
  freelanceScore          Float?        @default(70.0)
  appointmentScore        Float?        @default(70.0)

  business               Business?         @relation("BusinessOwner")
  payments               Payment[]         @relation("userPayments")
  payouts                Payout[]
  payoutRequests         PayoutRequest[]
  escrowsAsPayer         Escrow[]          @relation("escrowsAsPayer")
  escrowsAsPayee         Escrow[]          @relation("escrowsAsPayee")
  gigs                   Gig[]             @relation("UserGigs")
  trustPassport          TrustPassport?
  disputesFiled          Dispute[]         @relation("DisputesFiled")
  disputesAgainst        Dispute[]         @relation("DisputesAgainst")
  fiatPaymentsMade       FiatPayment[]     @relation("fiatPaymentsMade")
  fiatPaymentsReceived   FiatPayment[]     @relation("fiatPaymentsReceived")
  cryptoPaymentsMade     CryptoPayment[]   @relation("cryptoPaymentsMade")
  cryptoPaymentsReceived CryptoPayment[]   @relation("cryptoPaymentsReceived")
  trustAuditTrails       TrustAuditTrail[]
  notifications          Notification[]
  consents               Consent[]

  @@index([email])
  @@index([role])
}

model Business {
  id                    String           @id @default(cuid())
  ownerId               String?          @unique
  menuJson              Json?
  menuSyncedAt          DateTime?
  name                  String
  description           String?
  profileType           ProfileType?
  category              BusinessCategory
  address               String
  city                  String           @default("")
  country               String           @default("Pakistan")
  postalCode            String?
  phone                 String?
  email                 String?
  website               String?
  googlePlaceId         String?
  externalId            String?          @unique
  stripeAccountId       String?
  businessTier          String           @default("STANDARD")
  logoUrl               String?
  coverImageUrl         String?
  latitude              Float?
  longitude             Float?
  timezone              String           @default("Asia/Karachi")
  currency              String           @default("USD")
  bookingAdvanceDays    Int              @default(30)
  cancellationHours     Int              @default(24)
  requireDeposit        Boolean          @default(false)
  depositAmount         Float?
  depositPercentage     Float?
  isVerified            Boolean          @default(false)
  isActive              Boolean          @default(true)
  isPremium             Boolean          @default(false)
  acceptsAgentBookings  Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  rating                Float?
  reviewCount           Int              @default(0)
  reliabilityScore      Float?           @default(50.0)
  trustScore            Float            @default(70.0)
  fairPriceScore        Float            @default(85.0)
  communicationScore    Float            @default(85.0)
  state                 String           @default("")
  isClaimed             Boolean          @default(true)
  raastId               String?
  iban                  String?
  slug                  String?          @unique
  verifiedAt            DateTime?
  serviceAddress        String?
  serviceRadiusMiles    Float?           @default(25)
  maxConcurrentBookings Int              @default(1)

  owner                User?                   @relation("BusinessOwner", fields: [ownerId], references: [id])
  // Restored with the SMS feature (4e5b9e39 removed all four models). Each is
  // cascade-deleted with the business, so no orphan-cleanup path is needed.
  sMSLogs              SMSLog[]
  merchantSubscription MerchantSubscription?
  businessSmsProvider  BusinessSmsProvider?
  channelMessages      ChannelMessage[]
  technicians          Technician[]
  customers            Customer[]
  workOrders           WorkOrder[]
  bookings             Booking[]
  invoices             Invoice[]
  payments             Payment[]               @relation("businessPayments")
  gigs                 Gig[]
  telegramBot          TelegramBot?
  crmClients           CrmClient[]
  settings             BusinessSettings?
  businessHours        BusinessHours[]
  services             BusinessService[]
  squareConnection     SquareConnection?
  checkoutSessions     CheckoutSession[]
  fiatPayments         FiatPayment[]
  webhookEndpoints     WebhookEndpoint[]
  expenses             CrmExpense[]
  paymentMethods       BusinessPaymentMethod[]
  feeAssessments       FeeAssessment[]
  vehicles             Vehicle[]
  repairOrders         RepairOrder[]

  @@index([ownerId])
  @@index([slug])
  @@index([category])
}

model TrustPassport {
  id                  String    @id @default(cuid())
  handle              String    @unique
  agentId             String?
  category            String    @default("FREELANCER")
  displayName         String
  bio                 String?
  walletAddress       String?   @unique
  visibility          String    @default("PUBLIC")
  privacySettings     Json?
  socialLinks         Json?
  portfolioItems      Json?
  skills              Json?
  headline            String?
  location            String?
  websiteUrl          String?
  avatarUrl           String?
  coverImageUrl       String?
  displayTheme        String?   @default("clay")
  showOnPublicProfile Boolean   @default(true)
  claimsCount         Int       @default(0)
  riskScore           Int?
  riskBand            String?
  userId              String?   @unique
  score               Float?    @default(70.0)
  level               String?   @default("STANDARD")
  verified            Boolean?  @default(false)
  showUpScore         Int?      @default(500)
  paymentScore        Int?      @default(500)
  deliveryScore       Int?      @default(500)
  verifiedIdentity    Boolean   @default(false)
  verifiedAt          DateTime?
  fraudFlag           Boolean   @default(false)
  providerRef         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  crmClients CrmClient[]

  @@index([handle])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════════════════════════
// 2. DISPATCH & WORK ORDER DOMAIN (Technician, Customer, WorkOrder, Evidence)
// ══════════════════════════════════════════════════════════════════════════════

model Technician {
  id               String                @id @default(cuid())
  businessId       String
  name             String
  phoneEncrypted   String
  skills           String[]
  active           Boolean               @default(true)
  experienceYears  Int                   @default(0)
  reliabilityScore Float                 @default(50.0)
  passportId       String?
  createdAt        DateTime              @default(now())
  business         Business              @relation(fields: [businessId], references: [id])
  assignments      WorkOrderAssignment[]

  @@index([businessId])
  @@index([active])
}

model Customer {
  id             String      @id @default(cuid())
  businessId     String
  name           String
  email          String?
  phoneEncrypted String?
  address        String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  business       Business    @relation(fields: [businessId], references: [id])
  workOrders     WorkOrder[]

  @@index([businessId])
  @@index([name])
}

model WorkOrder {
  id            String                @id @default(cuid())
  businessId    String
  customerId    String
  status        WorkOrderStatus       @default(DRAFT)
  priority      Priority              @default(ROUTINE)
  issueType     String
  description   String
  address       String
  accessNotes   String?
  scheduledFor  DateTime?
  completedAt   DateTime?
  invoiceStatus InvoiceStatus         @default(NOT_READY)
  createdById   String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  customer      Customer              @relation(fields: [customerId], references: [id])
  business      Business              @relation(fields: [businessId], references: [id])
  booking       Booking?
  assignments   WorkOrderAssignment[]
  attachments   WorkOrderAttachment[]
  auditLog      WorkOrderAudit[]
  evidence      DisputeEvidence[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
}

model WorkOrderAssignment {
  id           String     @id @default(cuid())
  workOrderId  String
  technicianId String
  assignedAt   DateTime   @default(now())
  acceptedAt   DateTime?
  declinedAt   DateTime?
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id])
  technician   Technician @relation(fields: [technicianId], references: [id])

  @@unique([workOrderId, technicianId])
  @@index([technicianId])
}

model WorkOrderAttachment {
  id           String    @id @default(cuid())
  workOrderId  String
  kind         String
  url          String
  uploadedById String
  createdAt    DateTime  @default(now())
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model DisputeEvidence {
  id          String    @id @default(cuid())
  workOrderId String
  fileId      String    @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  vcapHash    String
  uploadedAt  DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model WorkOrderAudit {
  id          String    @id @default(cuid())
  workOrderId String
  actorId     String
  action      String
  before      Json?
  after       Json?
  requestId   String
  createdAt   DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@index([actorId])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// 3. GIGS & MARKETPLACE DOMAIN (Gig, Project, ProjectBid)
// ══════════════════════════════════════════════════════════════════════════════

model Gig {
  id             String   @id @default(cuid())
  title          String
  description    String
  category       String
  requiredSkills String[]
  budgetUsd      Float
  status         String   @default("OPEN")
  clientId       String?
  freelancerId   String?
  businessId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client   User?     @relation("UserGigs", fields: [clientId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  @@index([status])
  @@index([clientId])
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String
  requiredSkills  String[]
  budgetUsd       Float
  estimatedHours  Int      @default(0)
  demandGrowthPct Float    @default(0)
  status          String   @default("OPEN")
  vaultUsdc       Float    @default(0)
  yieldEarnedUsdc Float    @default(0)
  bestAgentId     String?
  bestConfidence  Float?
  createdBy       String?
  latitude        Float?
  longitude       Float?
  locationLabel   String?
  source          String?
  sourceRef       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bids ProjectBid[]

  @@index([status])
}

model ProjectBid {
  id            String   @id @default(cuid())
  projectId     String
  agentId       String
  confidencePct Float
  quoteUsd      Float
  stakePab      Float    @default(0)
  status        String   @default("PENDING")
  breakdown     Json?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([agentId])
}

// ══════════════════════════════════════════════════════════════════════════════
// 4. ESCROW & SETTLEMENT DOMAIN (Escrow, UniversalEscrow, Dispute)
// ══════════════════════════════════════════════════════════════════════════════

model Escrow {
  id                String       @id @default(cuid())
  paymentId         String?
  amount            Float
  status            String       @default("PENDING")
  payerId           String
  payer             User         @relation("escrowsAsPayer", fields: [payerId], references: [id])
  payeeId           String
  payee             User         @relation("escrowsAsPayee", fields: [payeeId], references: [id])
  releasedAt        DateTime?
  releasedBy        String?
  refundReason      String?
  businessId        String?
  userId            String?
  platformFeeAmount Float?
  platformFeeStatus String?      @default("NONE")
  description       String?
  deliverableHash   String?
  lockedAt          DateTime?
  createdAt         DateTime     @default(now())
  fiatPayment       FiatPayment?
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([payerId])
  @@index([payeeId])
}

model UniversalEscrow {
  id          String    @id @default(cuid())
  referenceId String    @unique
  template    String    @default("custom")
  parties     Json
  amount      Float
  currency    String    @default("USDC")
  conditions  Json
  status      String    @default("draft")
  deadline    DateTime?
  metadata    Json?
  rail        String?
  txHash      String?
  receiptRef  String?
  settledAt   DateTime?
  simulated   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([referenceId])
  @@index([status])
  @@index([template])
}

model Dispute {
  id           String         @id @default(cuid())
  userId       String?
  reportedById String?
  type         DisputeType
  description  String?
  outcome      DisputeOutcome @default(PENDING)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  stakedAmount Float          @default(0)
  contextType  String?
  contextId    String?
  evidenceUrls String[]
  aiReview     Json?
  aiConfidence Float?

  user     User? @relation("DisputesAgainst", fields: [userId], references: [id], onDelete: Cascade)
  reporter User? @relation("DisputesFiled", fields: [reportedById], references: [id])

  @@index([userId])
  @@index([contextType, contextId])
}

// ══════════════════════════════════════════════════════════════════════════════
// 5. PAYMENTS & LIQUIDITY DOMAIN (Payment, Invoice, Booking, Offramp, Receipts)
// ══════════════════════════════════════════════════════════════════════════════

model Booking {
  id            String    @id @default(cuid())
  businessId    String
  clientId      String?
  slotStart     DateTime
  slotEnd       DateTime
  serviceType   String
  depositAmount Float?
  depositStatus String?
  status        String    @default("pending")
  paymentRef    String?
  paidVia       String?
  metadata      Json?
  clientAddress String?
  clientLat     Float?
  clientLng     Float?
  distanceMiles Float?
  driveMinutes  Int?
  travelFee     Float?    @default(0)
  depositReason String?
  depositPaid   Boolean   @default(false)
  escrowStatus  String?
  completedAt   DateTime?
  passportId    String?
  // The CRM employee this job is assigned to. There is no separate assignment
  // table: CRM jobs ARE bookings, so a second table mirroring them would be a
  // dead relation nothing else reads.
  employeeId    String?
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      CrmClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  risk        BookingRisk?
  // The coordinator work order this booking created. @unique is the idempotency
  // mechanism: at most one work order per booking, and a retry cannot make a
  // second. See services/bookingWorkOrder.service.ts.
  workOrderId String?      @unique
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([businessId, slotStart])
  @@index([employeeId])
  @@index([employeeId, slotStart])
}

model BookingRisk {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  riskScore    Float
  confidence   Float
  band         String
  policy       String
  factors      Json
  features     Json
  modelVersion String
  calibrated   Boolean   @default(false)
  outcome      String?
  outcomeAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([outcome])
}

model AgentApiKey {
  id            String    @id @default(cuid())
  keyHash       String    @unique
  name          String
  ownerUserId   String
  agentId       String?
  scopes        String[]  @default([])
  spendLimitUsd Float?
  spendUsedUsd  Float     @default(0)
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([ownerUserId])
  @@index([agentId])
}

model AgentActionAudit {
  id            String   @id @default(cuid())
  agentKeyId    String
  agentId       String?
  userId        String
  action        String
  resourceType  String
  resourceId    String?
  amountUsd     Float?
  currency      String?  @default("USD")
  status        String
  ipAddress     String?
  userAgent     String?
  requestId     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([agentKeyId])
  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model PaidProof {
  id         String   @id @default(cuid())
  publicId   String   @unique
  bookingId  String   @unique
  workerId   String
  amount     Float
  currency   String   @default("USD")
  rail       String?
  txHash     String?
  receiptRef String?
  status     String   @default("PAID")
  createdAt  DateTime @default(now())

  @@index([workerId])
}

model Invoice {
  id               String    @id @default(cuid())
  number           String    @unique
  businessId       String
  clientId         String
  client           CrmClient @relation(fields: [clientId], references: [id])
  dateIssued       DateTime  @default(now())
  dateDue          DateTime
  status           String    @default("draft")
  lineItems        Json
  subtotal         Float     @default(0)
  notes            String?
  sentAt           DateTime?
  paidAt           DateTime?
  paymentLink      String?
  transactionHash  String?   @unique
  clientPassportId String?
  currency         String    @default("USD")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ReconciliationMatch ReconciliationMatch[]

  @@index([businessId, status])
  @@index([clientId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  businessId        String?
  bookingId         String?
  amount            Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  paymentMethod     String
  transactionId     String?       @unique
  gatewayResponse   Json?
  refunded          Boolean       @default(false)
  refundedAt        DateTime?
  refundAmount      Float?
  platformFeeAmount Float?
  platformFeeStatus String?       @default("NONE")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user     User      @relation("userPayments", fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation("businessPayments", fields: [businessId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@index([businessId])
}

model PaymentReceipt {
  id              String    @id @default(cuid())
  transactionRef  String    @unique
  amount          Float
  currency        String    @default("PKR")
  receiverId      String
  senderId        String?
  bank            String?
  timestamp       DateTime?
  screenshotUrl   String?
  imageHash       String?   @unique
  imageStorageKey String?
  imageUrl        String?
  rawJson         Json?
  confidence      Float     @default(0)
  status          String    @default("VERIFIED")
  intentId        String?
  paymentId       String?
  verifiedBy      String?
  reviewNotes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([transactionRef])
  @@index([receiverId])
  @@index([status])
}

model Payout {
  id              String   @id @default(cuid())
  userId          String
  amountUsdc      Float
  feeUsdc         Float
  netUsdc         Float
  method          String   @default("BANK")
  destinationRef  String?
  offrampIntentId String?
  status          String   @default("SETTLED")
  txHash          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PayoutRequest {
  id             String   @id @default(cuid())
  userId         String
  amount         Float
  currency       String   @default("USD")
  payoutMethod   String
  destinationRef String
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

