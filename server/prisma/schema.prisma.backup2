model CrmClient {
  id                String             @id @default(cuid())
  serviceBusinessId String
  serviceBusiness   CrmServiceBusiness @relation(fields: [serviceBusinessId], references: [id], onDelete: Cascade)
  name              String
  email             String
  phone             String
  address           String
  notes             String?
  totalJobs         Int                @default(0)
  totalSpent        Float              @default(0)
  lastJobAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  passportId     String?
  passport       TrustPassport   @relation(fields: [passportId], references: [id])

  jobs CrmJob[]

  @@index([serviceBusinessId])
  @@index([passportId])
  @@map("crm_clients")
}

model TrustPassport {
  id            String    @id @default(cuid())
  handle        String    @unique // shareable slug, e.g. "apex-builders"
  agentId       String? // Web3Agent.id if linked
  providerRef   String? // string key used across deposits/bonds/BC (landlordId/beneficiaryId/subjectId)
  category      String    @default("FREELANCER") // FREELANCER | BUILDER | FLEET | HOA | PROPERTY_MANAGER
  displayName   String
  bio           String?
  walletAddress String?
  visibility    String    @default("PUBLIC") // PUBLIC | PRIVATE
  claimsCount   Int       @default(0) // times requested/verified
  riskScore     Int?
  riskBand      String?
  lastCheckedAt DateTime?
  userId        String?  @unique
  score         Float?
  paymentScore    Float?   @default(500)
  level         String?
  verified      Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gigHistory   PassportGigHistory[]
  endorsements SkillEndorsement[]
  vector       PassportVector?

  @@index([handle])
  @@index([agentId])
  @@index([providerRef])

}



}


model CrmJob {
  id                String             @id @default(cuid())
  serviceBusinessId String
  serviceBusiness   CrmServiceBusiness @relation(fields: [serviceBusinessId], references: [id], onDelete: Cascade)
  clientId          String
  client            CrmClient          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName        String             // denormalized snapshot of client name at booking time
  serviceType       String             // free-form: "standard clean", "deep clean", "haircut", "lawn mow"
  scheduledDate     DateTime
  scheduledTime     String
  durationMinutes   Int?              // expected duration
  address           String
  notes             String?
  price             Float?
  status            String             @default("SCHEDULED")
  completedAt       DateTime?
  rating            Int?
  feedback          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recurrence        String   @default("one_time")  // "one_time" | "weekly" | "biweekly" | "monthly"
  parentJobId       String?                         // groups a recurring series; null for one-off jobs
  seriesIndex       Int?                            // 1st, 2nd, 3rd in series
  seriesEndDate     DateTime?                       // last date in the series
  @@index([serviceBusinessId])
  @@index([clientId])
  @@index([status])
  depositRequired   Boolean @default(false)
  depositAmount     Float?
  depositStatus     String?   // null | "requested" | "funded" | "released" | "forfeited" | "refunded"
  depositTxHash     String?   // reserved for real Solana integration later

  @@index([scheduledDate])
  @@index([parentJobId, seriesIndex])
  @@map("crm_jobs")
}

model CrmJobAssignment {