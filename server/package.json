{
  "name": "pabandi-server",
  "version": "1.0.7",
  "description": "Pabandi Backend API",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node --transpileOnly src/index.ts",
    "gcp-build": "prisma generate && tsc",
    "compile": "prisma generate && (tsc --noEmitOnError false || true) && node -e \"const fs=require('fs');fs.rmSync('dist/src/public',{recursive:true,force:true});fs.cpSync('src/public','dist/src/public',{recursive:true});fs.rmSync('dist/sql',{recursive:true,force:true});fs.cpSync('sql','dist/sql',{recursive:true})\"",
    "zk:build": "ts-node src/zk/buildZk.ts",
    "start": "node dist/src/index.js",
    "prestart": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "deploy:run": "gcloud run deploy pabandi-backend --source . --region asia-south1 --allow-unauthenticated --project pabandi-42c5b --env-vars-file env.yaml",
    "revoke:solana": "ts-node scripts/revoke-authorities.ts",
    "make:immutable": "ts-node scripts/make-immutable.ts",
    "update:metadata": "ts-node scripts/update-metadata.ts",
    "list:tokens": "ts-node scripts/list-wallet-tokens.ts",
    "burn:lp": "ts-node scripts/burn-lp.ts",
    "verify:agent-surface": "tsx scripts/verify-agent-surface.ts",
    "submit:registries": "tsx scripts/submit-mcp-registries.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:agent-docs": "tsx scripts/sync-agent-docs.ts",
    "compile:strict": "prisma generate && tsc && node -e \"const fs=require('fs');fs.rmSync('dist/src/public',{recursive:true,force:true});fs.cpSync('src/public','dist/src/public',{recursive:true});fs.rmSync('dist/sql',{recursive:true,force:true});fs.cpSync('sql','dist/sql',{recursive:true})\"",
    "check:runtime-deps": "tsx scripts/check-runtime-deps.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@dankelleher/solana-attestation-service-client": "^0.1.0",
    "@geoapify/geocoder-autocomplete": "^3.1.0",
    "@google/generative-ai": "^0.24.1",
    "@metaplex-foundation/mpl-bubblegum": "^6.0.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
