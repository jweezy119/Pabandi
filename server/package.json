    "@prisma/client": "^5.22.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.71-alpha",
    "@shopify/shopify-api": "^13.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@vonage/server-sdk": "^3.30.1",
    "axios": "^1.15.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bignumber.js": "^11.1.5",
    "bloom-filters": "^3.0.4",
    "bn.js": "^5.2.0",
    "bs58": "^6.0.0",
