# Server
NODE_ENV=production
PORT=5000
API_URL=https://pabandi.onrender.com/api/v1
FRONTEND_URL=https://pabandi.com
CLIENT_URL=https://pabandi.com

# Database
DATABASE_URL=

# Auth
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payments
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# ─── PayPal ──────────────────────────────────────────────────────────────────
# Three separate apps, three separate pairs. They used to share one unsuffixed
# pair, so rotating it for checkout silently broke sign-in. Do not merge them.

# Sign-in with PayPal (passport). Isolated because "the PayPal credentials" is
# ambiguous, and this pair is the one most easily clobbered by accident.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=

# Payments, Pabandi as seller of record. Money settles into Pabandi's account,
# which means custody: refunds, chargebacks, and working capital to cover the
# gap before paying out. At zero capital this is the hard path.
PAYPAL_MERCHANT_CLIENT_ID=
PAYPAL_MERCHANT_CLIENT_SECRET=

# Payments on behalf of connected sellers. The merchant is paid directly and
# Pabandi never holds the funds — the zero-capital path. Having these
# credentials does NOT mean PayPal has onboarded us as a platform; that
# approval is separate and must be confirmed.
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=

# Which pair handles payments: "merchant" (default when both are set) or
# "platform". Merchant is the default deliberately — it means Pabandi is seller
# of record, so opting into the merchant-owned model requires setting this
# explicitly rather than relying on which credentials happen to be present.
PAYPAL_PAYMENT_ACCOUNT=merchant

# Webhook id from the PayPal Developer Dashboard. Distinct from any client id
# or secret. Required for delivery verification; there is no shared-secret
# substitute, because PayPal signs with a certificate rather than an HMAC.
PAYPAL_WEBHOOK_ID=

# "live" or "sandbox". Defaults to live when NODE_ENV=production.
PAYPAL_ENV=live

SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SECRET=
SQUARE_LOCATION_ID=
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Shared secret for POST /treasury/autonomous/webhooks/fiat-deposit, sent as
# x-treasury-signature = HMAC-SHA256 hex of the raw body.
#
# Leave EMPTY until a banking partner is wired. While it is empty the endpoint
# returns 503 and credits nothing: it was previously unauthenticated, so anyone
# could declare an arbitrary wire amount into the treasury. A real partner will
# replace this scheme with its own signature, at which point this can be removed.
TREASURY_FIAT_WEBHOOK_SECRET=

# CashApp
CASHAPP_CLIENT_ID=
CASHAPP_CLIENT_SECRET=
CASHAPP_MERCHANT_ID=
CASHAPP_WEBHOOK_SECRET=

