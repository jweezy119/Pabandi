# Server
NODE_ENV=production
PORT=5000
API_URL=https://pabandi.onrender.com/api/v1
FRONTEND_URL=https://pabandi.com
CLIENT_URL=https://pabandi.com

# Database
# connection_limit caps the pool per process; pool_timeout is in seconds and
# bounds how long a request waits for a connection before erroring. The API
# process and the BullMQ worker (npm run worker) each open their own pool, so
# size the database's max_connections for the sum of both.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=10&pool_timeout=20

# Auth
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payments
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# ─── PayPal ──────────────────────────────────────────────────────────────────
# Three separate apps, three separate pairs. They used to share one unsuffixed
# pair, so rotating it for checkout silently broke sign-in. Do not merge them.

# Sign-in with PayPal (passport). Isolated because "the PayPal credentials" is
# ambiguous, and this pair is the one most easily clobbered by accident.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=

# Payments, Pabandi as seller of record. Money settles into Pabandi's account,
# which means custody: refunds, chargebacks, and working capital to cover the
# gap before paying out. At zero capital this is the hard path.
PAYPAL_MERCHANT_CLIENT_ID=
PAYPAL_MERCHANT_CLIENT_SECRET=

# Payments on behalf of connected sellers. The merchant is paid directly and
# Pabandi never holds the funds — the zero-capital path. Having these
# credentials does NOT mean PayPal has onboarded us as a platform; that
# approval is separate and must be confirmed.
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=

# Which pair handles payments: "merchant" (default when both are set) or
# "platform". Merchant is the default deliberately — it means Pabandi is seller
# of record, so opting into the merchant-owned model requires setting this
# explicitly rather than relying on which credentials happen to be present.
PAYPAL_PAYMENT_ACCOUNT=merchant

# Webhook id from the PayPal Developer Dashboard. Distinct from any client id
# or secret. Required for delivery verification; there is no shared-secret
# substitute, because PayPal signs with a certificate rather than an HMAC.
PAYPAL_WEBHOOK_ID=

# "live" or "sandbox". Defaults to live when NODE_ENV=production.
PAYPAL_ENV=live

SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SECRET=
SQUARE_LOCATION_ID=
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Platform fee billing — when 'true', the escrow release path collects the
# platform fee (see config/fees.ts) and sweeps it to the PLATFORM_REV treasury
# bucket. Disabled by default; flip to 'true' to turn on billing. Collected via
# existing rails (Square/PayPal/PayLio/SafePay/etc.), never Stripe.
PLATFORM_FEE_ENABLED=true

# Yield Provider (escrow yield on Solana / Kamino-style vaults)
# mock = in-memory 4% APY simulator (default, safe for local/testing)
# solana = real web3.js adapter routing USDC into a devnet vault
YIELD_PROVIDER=mock

# Shared secret for POST /treasury/autonomous/webhooks/fiat-deposit, sent as
# x-treasury-signature = HMAC-SHA256 hex of the raw body.
#
# Leave EMPTY until a banking partner is wired. While it is empty the endpoint
# returns 503 and credits nothing: it was previously unauthenticated, so anyone
# could declare an arbitrary wire amount into the treasury. A real partner will
# replace this scheme with its own signature, at which point this can be removed.
TREASURY_FIAT_WEBHOOK_SECRET=

# CashApp
CASHAPP_CLIENT_ID=
CASHAPP_CLIENT_SECRET=
CASHAPP_MERCHANT_ID=
CASHAPP_WEBHOOK_SECRET=

# PayLio
PAYLIO_API_KEY=
PAYLIO_MERCHANT_ID=
PAYLIO_WEBHOOK_SECRET=

# Session signing secrets. Recommended: distinct 32+ char random values.
# If unset, sessions fall back to JWT_SECRET (server.ts still requires JWT_SECRET
# to be at least 16 chars in production).
SESSION_SECRET=
COOKIE_SESSION_SECRET=

# Payment webhook signing secrets (REQUIRED in production).
# Unsigned events are rejected — an unset secret does not mean "skip checks".
BTCPAY_WEBHOOK_SECRET=
RAAST_WEBHOOK_SECRET=
OFFRAMP_WEBHOOK_SECRET=

# Enable the data-retention cron (0/1). See docs on compliance retention.
ENABLE_RETENTION_CRON=

# Crypto On-Ramp
MOONPAY_API_KEY=
TRANSAK_API_KEY=

# Email / SMS
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pabandi <jay@pabandi.com>
RESEND_API_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=

# AI providers (any one or more; router tries them in order).
# Total budget for the fallback chain; each provider attempt is capped at 20s.
AI_ROUTER_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
NVIDIA_API_KEY=
NVIDIA_MODEL=auto
NVIDIA_MODELS=moonshotai/kimi-k3.1-pro,z-ai/glm-5.3-flash,minimaxai/minimax-m3.1-flash,google/gemma-4-31b-it,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b,stepfun-ai/step-5-preview
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODELS=z-ai/glm-5.3-flash,minimaxai/minimax-m3.1-flash,stepfun-ai/step-5-preview
POLLINATIONS_ENABLED=false
POLLINATIONS_MODEL=gpt-oss-20b
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai

# Receipt image object storage (S3-compatible). Leave STORAGE_ENDPOINT empty to
# store under server/uploads/receipts for local development.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_APP_CHECK_SECRET=

# Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
COURTLISTENER_API_KEY=
HIBP_API_KEY=
COMPANIES_HOUSE_KEY=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_ID=
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_PHONE=
META_WA_VERIFY_TOKEN=
CHANNEX_API_KEY=

# Webacy Risk Intelligence (Solana wallet threat & sanctions screening)
# Free developer tier (~500 req/month) at https://developers.webacy.com/
# Leave WEBACY_API_KEY empty to keep screening inactive (returns status: "unconfigured").
WEBACY_API_KEY=
WEBACY_API_BASE_URL=https://api.webacy.com
# Hard-block Solana escrow oracle co-signing at or above this 0-100 risk score (sanctions always block).
WEBACY_MAX_ESCROW_RISK=75
# Cache TTL in ms (default 15m = 900000) to protect free-tier quota across repeat lookups.
WEBACY_CACHE_TTL_MS=900000
WEBACY_TIMEOUT_MS=5000
# When false (default), upstream 429/timeout fails open with a warning while confirmed high-risk wallets still hard-block.
WEBACY_FAIL_CLOSED=false

# Blockchain
SOLANA_RPC_URL=
SOLANA_PUBKEY=
SOLANA_PRIVATE_KEY=
SOLANA_ANCHOR_SECRET=
SOLANA_PAB_MINT_ADDRESS=
# Canonical $PAB mint is 4MLskKmcnz8bVaPfEuVbhZGsbeUMZqKjQYQQDEX6WQcQ
# (name "Pabandi", symbol "PAB"). Leave BLANK to use that default — code resolves
# it via getPabMint() in src/config/pabToken.ts. Do NOT set this to
# G811FHWiZrqY1DZKz6dQySpJFPTDfe21B8LRnDqa1z5Y; that mint has no metadata,
# a single holder, and zero treasury balance.
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PLATFORM_WALLET_ADDRESS=
PLATFORM_PRIVATE_KEY=
TREASURY_WALLET=
BROKERAGE_REVENUE_WALLET=
FEE_TREASURY_WALLET=
PABANDI_API_KEY=
PAB_TOKEN_ADDRESS=
ESCROW_CONTRACT_ADDRESS=
ESCROW_API_KEY=
ESCROW_API_EMAIL=
ESCROW_API_BASE=
RELAYER_PRIVATE_KEY=
MINTER_PRIVATE_KEY=
ENCRYPTION_KEY=
WALLET_ENC_KEY=
BADGE_SALT=
PTP_SIGNING_SECRET=
SOL_FEE_BASE=0.0003
SOL_FEE_RATE=0.00001
REGULATED_MODE=false
VASP_LICENSED=false
SETTLEMENT_PARTNER=
MIGRATION_TOKEN=

# ── Agent surface ─────────────────────────────────────────────────────────────
# The host agents are given for MCP, llms.txt and /api/v1. Point api.pabandi.com
# at Render before publishing it in a directory listing. Leave unset to fall back
# to the Render hostname.
PUBLIC_API_URL=https://api.pabandi.com

# ES256 (ECDSA P-256) keypair for signing Verifiable Credentials.
# Credentials signed with this are verifiable by anyone via the public key at
# /.well-known/pabandi-keys.json — it must therefore be asymmetric, and it must
# NOT be JWT_SECRET. There is no development fallback: signing credentials with a
# hardcoded key would let anyone mint them.
#
# Generate a value for this line:
#   node -e "const c=require('crypto');console.log('VC_SIGNING_PRIVATE_KEY='+JSON.stringify(c.generateKeyPairSync('ec',{namedCurve:'prime256v1',privateKeyEncoding:{type:'pkcs8',format:'pem'}}).privateKey.trim()))"
#
# Newlines may be stored as literal \n. Keep the key out of git and rotate it by
# generating a new one; the public half is derived, never committed.
VC_SIGNING_PRIVATE_KEY=

# Internal support admin console at /support-admin. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SUPPORT_TOKEN=
