# ── Agent surface ─────────────────────────────────────────────────────────────
# The host agents are given for MCP, llms.txt and /api/v1. Point api.pabandi.com
# at Render before publishing it in a directory listing. Leave unset to fall back
# to the Render hostname.
PUBLIC_API_URL=https://api.pabandi.com

# ES256 (ECDSA P-256) keypair for signing Verifiable Credentials.
# Credentials signed with this are verifiable by anyone via the public key at
# /.well-known/pabandi-keys.json — it must therefore be asymmetric, and it must
# NOT be JWT_SECRET. There is no development fallback: signing credentials with a
# hardcoded key would let anyone mint them.
#
# Generate a value for this line:
#   node -e "const c=require('crypto');console.log('VC_SIGNING_PRIVATE_KEY='+JSON.stringify(c.generateKeyPairSync('ec',{namedCurve:'prime256v1',privateKeyEncoding:{type:'pkcs8',format:'pem'}}).privateKey.trim()))"
#
# Newlines may be stored as literal \n. Keep the key out of git and rotate it by
# generating a new one; the public half is derived, never committed.
VC_SIGNING_PRIVATE_KEY=
